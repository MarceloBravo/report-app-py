# Puerto del servicio
SERVICE_PORT=8000

# Proveedor LLM (openai | anthropic | ollama)
LLM_PROVIDER=openai

# Modelo LLM por defecto
LLM_MODEL=gpt-4o-mini-2024-07-18

# URL base opcional para proveedores compatibles con OpenAI.
# En blanco usa el endpoint oficial del proveedor elegido.
LLM_BASE_URL=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Ollama (local, coste cero) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Ollama no requiere API key (se usa un valor ficticio).

# --- Anthropic (opcional) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Límites y timeouts
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
# Segunda pasada de revisión/corrección de JOINs por claves foráneas
# (cuesta una llamada extra al LLM cuando el esquema tiene relaciones)
LLM_REVISAR_FK=true
MAX_SCHEMA_TABLES=50
MAX_SCHEMA_COLUMNS=200
MAX_PROMPT_CHARS=8000

# CORS (para desarrollo con Spring Boot local)
CORS_ALLOWED_ORIGINS=http://localhost:8080
